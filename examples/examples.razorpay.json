  "integration_flow_example": {
    "description": "Complete flow integrating Razorpay with Agentic Checkout",
    "steps": [
      {
        "step": 1,
        "action": "Create checkout session",
        "endpoint": "POST /checkout_sessions (Agentic Checkout API)",
        "result": "checkout_session_id"
      },
      {
        "step": 2,
        "action": "Create Razorpay order",
        "endpoint": "POST /v1/orders (Razorpay API)",
        "request_reference": "create_order_request",
        "response_reference": "create_order_response",
        "notes": "Link checkout_session_id in order notes"
      },
      {
        "step": 3,
        "action": "Collect payment details from user",
        "description": "User provides card/UPI details through agent interface"
      },
      {
        "step": 4,
        "action": "Create payment",
        "endpoint": "POST /v1/payments (Razorpay API)",
        "request_reference": "create_payment_card_request",
        "response_reference": "create_payment_card_response",
        "notes": "Use order_id from step 2"
      },
      {
        "step": 5,
        "action": "Capture payment (if authorized)",
        "endpoint": "POST /v1/payments/{payment_id}/capture (Razorpay API)",
        "request_reference": "capture_payment_request",
        "response_reference": "capture_payment_response"
      },
      {
        "step": 6,
        "action": "Complete checkout session",
        "endpoint": "POST /checkout_sessions/{id}/complete (Agentic Checkout API)",
        "notes": "Update session status to completed with order details"
      }
    ]
  }
